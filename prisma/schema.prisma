generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TaxConfiguration {
  id              String   @id @default(uuid())
  taxName         String   // e.g., 'STANDARD_GST', 'GOVT_WHT_GOODS'
  taxRatePercent  Float    // e.g., 18.00 for GST, 5.00 for WHT
  isActive        Boolean  @default(true)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("tax_configurations")
}

model Client {
  id                  String   @id @default(uuid())
  code                String   @unique // e.g., 'CL-QTA-GPO-01'
  name                String   // e.g., 'Quetta GPO (Pakistan Post)'
  clientType          String   @default("GOVERNMENT") // GOVERNMENT, CORPORATE, WHOLESALE, WALK_IN
  ntnNumber           String?  // Mandatory for FBR
  strnNumber          String?  // Sales Tax Registration Number
  isWithholdingAgent  Boolean  @default(true)
  defaultWhtRate      Float    @default(5.00)
  address             String
  city                String   @default("Quetta")
  phone               String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  tenderContracts     TenderContract[]
  invoices            Invoice[]

  @@map("clients")
}

model Product {
  id                    String   @id @default(uuid())
  sku                   String   @unique // e.g., 'PAP-A4-80G-BLC'
  name                  String   // e.g., 'A4 Photocopy Paper 80GSM'
  brand                 String   // e.g., 'Double A'
  hsCode                String   // FBR HS Code e.g., '4802.5600'
  baseUom               String   // Primary UOM: 'Reams', 'Pieces', 'Boxes'
  baseCost              Float    // Purchase cost before tax
  standardRetailPrice   Float    // Walk-in customer price (excl. GST)
  standardGstPercent    Float    @default(18.00)
  minStockAlert         Int      @default(50)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  uomConversions        ProductUomConversion[]
  inventoryStocks       InventoryStock[]
  lockedTenderRates     LockedTenderRate[]
  invoiceItems          InvoiceItem[]

  @@map("products")
}

model ProductUomConversion {
  id                String  @id @default(uuid())
  productId         String
  alternateUom      String  // 'Carton', 'Dozen', 'Packet'
  conversionFactor  Float   // e.g., 5.0 (1 Carton = 5 Reams)
  barcode           String?

  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_uom_conversions")
}

model WarehouseLocation {
  id              String   @id @default(uuid())
  warehouseName   String   // e.g., 'Main Godown (Zarghoon Rd)'
  floorCode       String   // e.g., 'FL-G', 'FL-01'
  floorName       String   // e.g., 'Ground Floor'
  sectionAisle    String   // e.g., 'Aisle-03 (Paper Products)'
  rackShelf       String   // e.g., 'Rack-B / Shelf-4'
  locationCode    String   @unique // e.g., 'MG-FL0-AIS03-RKB-SH4'
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  inventoryStocks InventoryStock[]
  invoiceItems    InvoiceItem[]

  @@map("warehouse_locations")
}

model InventoryStock {
  id                 String   @id @default(uuid())
  productId          String
  locationId         String
  quantityOnHand     Float    @default(0)
  quantityAllocated  Float    @default(0)
  lastAuditedAt      DateTime?

  product            Product           @relation(fields: [productId], references: [id])
  location           WarehouseLocation @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
  @@map("inventory_stocks")
}

model TenderContract {
  id                 String   @id @default(uuid())
  tenderReferenceNo  String   // e.g., 'TND-POST-2024-89B'
  clientId           String
  title              String   // e.g., 'Annual Stationery Framework 2024-25'
  financialYear      String   // e.g., '2024-2025'
  startDate          DateTime
  endDate            DateTime
  status             String   @default("DRAFT") // DRAFT, SUBMITTED, WON_LOCKED, EXPIRED, TERMINATED
  contractFileUrl    String?
  createdAt          DateTime @default(now())

  client             Client             @relation(fields: [clientId], references: [id])
  lockedRates        LockedTenderRate[]
  invoices           Invoice[]

  @@map("tender_contracts")
}

model LockedTenderRate {
  id                         String   @id @default(uuid())
  contractId                 String
  productId                  String
  baseCostSnapshot           Float
  freightHandlingPerUnit     Float    @default(0)
  targetProfitMarginPercent  Float
  gstPercentSnapshot         Float    @default(18.00)
  sourceWhtPercentSnapshot   Float    @default(5.00)
  lockedNetRate              Float    // Unit rate EXCLUDING GST
  lockedGrossRate            Float    // Unit rate INCLUDING GST
  committedQuantity          Float?
  isActive                   Boolean  @default(true)
  createdAt                  DateTime @default(now())

  contract                   TenderContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  product                    Product        @relation(fields: [productId], references: [id])

  @@unique([contractId, productId])
  @@map("locked_tender_rates")
}

model Invoice {
  id                     String   @id @default(uuid())
  invoiceNumber          String   @unique // 'INV-2024-00941'
  clientId               String
  tenderContractId       String?
  invoiceDate            DateTime @default(now())
  dueDate                DateTime?

  subtotalTaxableValue   Float    @default(0)
  totalSalesTaxAmount    Float    @default(0)
  totalWhtDeducted       Float    @default(0)
  grandTotalPayable      Float    @default(0)

  fbrInvoiceNumber       String?  // Returned by FBR API
  fbrQrCodeData          String?  // Base64 or QR string from FBR
  fbrSyncStatus          String   @default("PENDING") // PENDING, SUCCESS, FAILED, MANUAL_EXEMPT
  fbrSyncResponse        String?  // JSON string
  fbrSyncedAt            DateTime?

  status                 String   @default("ISSUED") // DRAFT, ISSUED, PAID, CANCELLED
  createdAt              DateTime @default(now())

  client                 Client           @relation(fields: [clientId], references: [id])
  tenderContract         TenderContract?  @relation(fields: [tenderContractId], references: [id])
  items                  InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id                  String  @id @default(uuid())
  invoiceId           String
  productId           String
  hsCode              String
  uom                 String
  quantity            Float

  rateTypeApplied     String  // 'LOCKED_TENDER', 'STANDARD_RETAIL', 'WHOLESALE'
  unitPriceExclTax    Float
  salesTaxPercent     Float
  salesTaxAmount      Float
  totalPriceInclTax   Float

  pickedLocationId    String

  invoice             Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product             Product           @relation(fields: [productId], references: [id])
  pickedLocation      WarehouseLocation @relation(fields: [pickedLocationId], references: [id])

  @@map("invoice_items")
}
