generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Client {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  department          String?
  contactPerson       String?
  clientType          String   @default("GOVERNMENT")
  address             String
  city                String   @default("Quetta")
  phone               String?
  totalOutstandingBalance Float @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  chits               Chit[]

  @@map("clients")
}

model Product {
  id                    String   @id @default(uuid())
  sku                   String   @unique
  name                  String
  brand                 String
  hsCode                String   
  baseUom               String   
  baseCost              Float    
  standardRetailPrice   Float    
  minStockAlert         Int      @default(50)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  uomConversions        ProductUomConversion[]
  inventoryStocks       InventoryStock[]
  chitItems             ChitItem[]

  @@map("products")
}

model ProductUomConversion {
  id                String  @id @default(uuid())
  productId         String
  alternateUom      String
  conversionFactor  Float
  barcode           String?

  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_uom_conversions")
}

model WarehouseLocation {
  id              String   @id @default(uuid())
  warehouseName   String
  floorCode       String
  floorName       String
  sectionAisle    String
  rackShelf       String
  locationCode    String   @unique
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  inventoryStocks InventoryStock[]
  chitItems       ChitItem[]

  @@map("warehouse_locations")
}

model InventoryStock {
  id                 String   @id @default(uuid())
  productId          String
  locationId         String
  quantityOnHand     Float    @default(0)
  quantityAllocated  Float    @default(0)
  lastAuditedAt      DateTime?

  product            Product           @relation(fields: [productId], references: [id])
  location           WarehouseLocation @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
  @@map("inventory_stocks")
}

model Chit {
  id              String   @id @default(uuid())
  chitNumber      String   @unique
  clientId        String
  issuingOfficer  String
  dateIssued      DateTime @default(now())
  dueDate         DateTime?
  totalAmount     Float    @default(0)
  paidAmount      Float    @default(0)
  status          String   @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID
  imagePath       String?
  rawOcrText      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client          Client      @relation(fields: [clientId], references: [id])
  items           ChitItem[]
  payments        Payment[]

  @@map("chits")
}

model ChitItem {
  id                  String  @id @default(uuid())
  chitId              String
  productId           String
  quantity            Float
  unitPrice           Float
  total               Float
  pickedLocationId    String

  chit                Chit              @relation(fields: [chitId], references: [id], onDelete: Cascade)
  product             Product           @relation(fields: [productId], references: [id])
  pickedLocation      WarehouseLocation @relation(fields: [pickedLocationId], references: [id])

  @@map("chit_items")
}

model Payment {
  id             String   @id @default(uuid())
  chitId         String
  paymentDate    DateTime @default(now())
  amountPaid     Float
  paymentMethod  String   // CASH, CHEQUE, BANK_TRANSFER
  notes          String?

  chit           Chit     @relation(fields: [chitId], references: [id], onDelete: Cascade)

  @@map("payments")
}
